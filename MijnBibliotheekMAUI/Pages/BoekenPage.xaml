<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MijnBibliotheekMAUI.Pages.BoekenPage"
             Title="Boeken">

    <Grid RowDefinitions="Auto, Auto, *">
        <VerticalStackLayout Grid.Row="0" Padding="10">
            <Button Text="Vernieuwen" Command="{Binding RefreshCommand}" />
            <Label Text="{Binding Error}" TextColor="Red" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Boeken}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="12" Margin="10,6">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Titel}" FontSize="18" FontAttributes="Bold" />
                            <Label Text="{Binding Auteur}" TextColor="Gray" />

                            <Label>
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Beschikbaar: " />
                                        <Span Text="{Binding IsBeschikbaar}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Leen"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.LeenCommand}"
                                        CommandParameter="{Binding .}" />

                                <Button Text="Delete (admin)"
                                        BackgroundColor="Red"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IsAdmin}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                        CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
