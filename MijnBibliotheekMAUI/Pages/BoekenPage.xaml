<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MijnBibliotheekMAUI.Pages.BoekenPage"
             Title="Boeken">

    <VerticalStackLayout Padding="16" Spacing="12">

        <Button Text="Vernieuwen" Command="{Binding RefreshCommand}" />

        <Label Text="{Binding Error}" TextColor="Red" />

        <CollectionView ItemsSource="{Binding Boeken}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="12" Margin="0,6">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Titel}" FontSize="18" />
                            <Label Text="{Binding Auteur}" />

                            <Label>
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Beschikbaar: " />
                                        <Span Text="{Binding IsBeschikbaar}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Leen"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.LeenCommand}"
                                        CommandParameter="{Binding .}" />

                                <Button Text="Delete (admin)"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IsAdmin}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                        CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>
