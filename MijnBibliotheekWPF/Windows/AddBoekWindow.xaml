<Window x:Class="MijnBibliotheekWPF.Windows.AddBoekWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nieuw Boek Toevoegen" Width="400" Height="340"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>

            <TextBlock Text="Titel"/>
            <TextBox x:Name="TitelBox" Margin="0 4 0 10"/>

            <TextBlock Text="Auteur"/>
            <TextBox x:Name="AuteurBox" Margin="0 4 0 10"/>

            <TextBlock Text="ISBN"/>
            <TextBox x:Name="ISBNBox" Margin="0 4 0 10"/>

            <TextBlock Text="Categorie"/>
            <ComboBox x:Name="CategorieSelect" DisplayMemberPath="Naam" SelectedValuePath="Id"
                      Height="28" Margin="0 4 0 10"/>

        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuleren" Width="90" Margin="0 0 10 0" Click="Cancel_Click"/>
            <Button Content="Opslaan" Width="90" Click="Save_Click"/>
        </StackPanel>

    </Grid>
</Window>
