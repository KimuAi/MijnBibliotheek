<Window x:Class="MijnBibliotheekWPF.Windows.UitleningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uitleningen" Height="520" Width="800" WindowStartupLocation="CenterScreen">

    <DockPanel Margin="10">

        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0 0 0 8">
            <ComboBox x:Name="BoekSelect" Width="180" DisplayMemberPath="Titel"/>
            <ComboBox x:Name="UserSelect" Width="180" Margin="6 0" DisplayMemberPath="VolledigeNaam"/>
            <DatePicker x:Name="StartPicker" Margin="6 0"/>
            <DatePicker x:Name="EndPicker" Margin="6 0"/>
            <Button x:Name="OpslaanBtn" Content="Uitlenen" Click="Opslaan_Click" Margin="6 0"/>
        </StackPanel>

        <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Boek" Binding="{Binding Boek.Titel}"/>
                <DataGridTextColumn Header="Lid" Binding="{Binding AppUser.VolledigeNaam}"/>
                <DataGridTextColumn Header="Van" Binding="{Binding StartDatum}"/>
                <DataGridTextColumn Header="Tot" Binding="{Binding EindDatum}"/>
                <DataGridCheckBoxColumn Header="Terug" Binding="{Binding IsTeruggebracht}"/>

                <DataGridTemplateColumn Header="Terugbrengen" x:Name="TerugColumn">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="✔" Tag="{Binding}" Click="Terug_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
