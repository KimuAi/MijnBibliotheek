<Window x:Class="MijnBibliotheekWPF.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mijn Bibliotheek" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <!-- Top Balk -->
        <StackPanel Orientation="Horizontal" Background="#EEE" DockPanel.Dock="Top" Margin="0,0,0,5" Height="45">
            <TextBlock Text="📚 Mijn Bibliotheek" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBlock x:Name="RoleText" Margin="20,0,0,0" VerticalAlignment="Center"/>
            <Button Content="Afmelden" Click="Logout_Click" Margin="0,0,10,0" Width="100"/>
        </StackPanel>

        <!-- Menu Knoppen -->
        <StackPanel Orientation="Horizontal" Background="#DDD" DockPanel.Dock="Top" Height="40" Margin="0,0,0,5">
            <Button Content="Boeken" Width="150" Margin="5" Click="OpenBoeken"/>
            <Button Content="Categorieën" Width="150" Margin="5" Click="OpenCategorieen"/>
            <Button Content="Uitleningen" Width="150" Margin="5" Click="OpenUitleningen"/>
        </StackPanel>

        <Grid Background="White"/>
    </DockPanel>

</Window>
