@model MijnBibliotheekWeb.ViewModels.UitleningCreateVm
@{
    ViewData["Title"] = "Nieuwe uitlening";
}

<h2>Nieuwe uitlening</h2>

<form method="post">
    <div class="mb-3">
        <label class="form-label">Boek</label>
        <select class="form-select" asp-for="BoekId" asp-items="ViewBag.Boeken"></select>
        <span class="text-danger" asp-validation-for="BoekId"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Lid</label>
        <select class="form-select" asp-for="AppUserId" asp-items="ViewBag.Users"></select>
        <span class="text-danger" asp-validation-for="AppUserId"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Startdatum</label>
        <input class="form-control" asp-for="StartDatum" type="date" />
    </div>

    <div class="mb-3">
        <label class="form-label">Einddatum</label>
        <input class="form-control" asp-for="EindDatum" type="date" />
    </div>

    <button class="btn btn-primary" type="submit">Opslaan</button>
    <a class="btn btn-secondary" asp-action="Index">Terug</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
