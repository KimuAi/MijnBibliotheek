@model List<MijnBibliotheekModels.Models.Categorie>
@{
    ViewData["Title"] = "Categorieën";
    bool canEdit = User.IsInRole("Admin") || User.IsInRole("Medewerker");
}

<h2>Categorieën</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (canEdit)
{
    <form asp-action="Add" method="post" class="row g-2 mb-4">
        <div class="col-md-6">
            <input class="form-control" name="naam" placeholder="Nieuwe categorie..." required />
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary w-100" type="submit">+ Toevoegen</button>
        </div>
    </form>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Naam</th>
            @if (canEdit)
            {
                <th style="width: 250px;">Acties</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                @if (canEdit)
                {
                    <td>
                        <form asp-action="Edit" method="post" class="d-flex gap-2">
                            <input type="hidden" name="id" value="@c.Id" />
                            <input class="form-control form-control-sm" name="naam" value="@c.Naam" required />
                            <button class="btn btn-sm btn-outline-primary" type="submit">Opslaan</button>
                        </form>
                    </td>
                    <td>
                        <form asp-action="Delete" asp-route-id="@c.Id" method="post" onsubmit="return confirm('Zeker weten dat je deze categorie wilt verwijderen?');">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Verwijderen</button>
                        </form>
                    </td>
                }
                else
                {
                    <td>@c.Naam</td>
                }
            </tr>
        }
    </tbody>
</table>
