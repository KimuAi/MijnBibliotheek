@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model List<MijnBibliotheekModels.Models.Boek>

@{
    bool canEdit = User.IsInRole("Admin") || User.IsInRole("Medewerker");
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Localizer["Title"]</th>
            <th>@Localizer["Author"]</th>
            <th>@Localizer["ISBN"]</th>
            <th>@Localizer["Category"]</th>
            <th>@Localizer["Available"]</th>
            @if (canEdit)
            {
                <th>@Localizer["Actions"]</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td>@b.Titel</td>
                <td>@b.Auteur</td>
                <td>@b.ISBN</td>
                <td>@b.Categorie?.Naam</td>
                <td>@(b.IsBeschikbaar ? Localizer["Yes"] : Localizer["No"])</td>
                @if (canEdit)
                {
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@b.Id">@Localizer["Edit"]</a>
                        <form asp-action="Delete" asp-route-id="@b.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-outline-danger" type="submit">@Localizer["Delete"]</button>
                        </form>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
