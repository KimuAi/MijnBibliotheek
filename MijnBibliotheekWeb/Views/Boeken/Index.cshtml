@model List<MijnBibliotheekModels.Models.Boek>
@{
    ViewData["Title"] = "Boeken";
    bool canEdit = User.IsInRole("Admin") || User.IsInRole("Medewerker");
}

<h2>Boeken</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input class="form-control" name="q" value="@ViewBag.Q" placeholder="Zoek titel/auteur/ISBN..." />
    </div>
    <div class="col-md-3">
        <select class="form-select" name="catId" asp-items="ViewBag.Cats">
            <option value="">Alle categorieën</option>
        </select>
    </div>
    <div class="col-md-2">
        <button class="btn btn-secondary w-100" type="submit">Filter</button>
    </div>
    @if (canEdit)
    {
        <div class="col-md-3">
            <a class="btn btn-primary w-100" asp-action="Create">Nieuw boek</a>
        </div>
    }
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Titel</th>
            <th>Auteur</th>
            <th>ISBN</th>
            <th>Categorie</th>
            <th>Beschikbaar</th>
            @if (canEdit)
            {
                <th>Acties</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td>@b.Titel</td>
                <td>@b.Auteur</td>
                <td>@b.ISBN</td>
                <td>@b.Categorie?.Naam</td>
                <td>@(b.IsBeschikbaar ? "Ja" : "Nee")</td>
                @if (canEdit)
                {
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@b.Id">Bewerk</a>
                        <form asp-action="Delete" asp-route-id="@b.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Verwijder</button>
                        </form>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
