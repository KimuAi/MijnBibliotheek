@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Mvc.Rendering
@model MijnBibliotheekWeb.ViewModels.BoekEditVm
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["NewBook"];
    var categories = ViewData["Cats"] as IEnumerable<SelectListItem>;
}

<h2>@Localizer["NewBook"]</h2>

<form method="post">
    <div class="mb-3">
        <label class="form-label">@Localizer["Title"]</label>
        <input class="form-control" asp-for="Titel" />
        <span class="text-danger" asp-validation-for="Titel"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">@Localizer["Author"]</label>
        <input class="form-control" asp-for="Auteur" />
        <span class="text-danger" asp-validation-for="Auteur"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">@Localizer["ISBN"]</label>
        <input class="form-control" asp-for="ISBN" />
        <span class="text-danger" asp-validation-for="ISBN"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">@Localizer["Category"]</label>
        <select class="form-select" asp-for="CategorieId" asp-items="categories"></select>
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input" asp-for="IsBeschikbaar" />
        <label class="form-check-label" asp-for="IsBeschikbaar">@Localizer["Available"]</label>
    </div>

    <button class="btn btn-primary" type="submit">@Localizer["Save"]</button>
    <a class="btn btn-secondary" asp-action="Index">@Localizer["Back"]</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
